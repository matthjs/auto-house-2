# Copy this file to .env and fill in what you use. .env is git-ignored.
# wgzimmer.ch needs nothing from this file. Batch mode (command=run) needs an
# LLM key; Flatfox and wohnen.ethz.ch need the contact's logins.

# Defaults so you can leave out search=... and llm=... (optional).
# Without AUTO_HOUSE_LLM, the provider whose API key is set below is used.
AUTO_HOUSE_SEARCH=
AUTO_HOUSE_LLM=

# LLM API key for batch mode (command=run); only the one you use
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# The search contact's accounts
# wohnen.ethz.ch account
WOHNEN_ETHZ_LOGIN=
WOHNEN_ETHZ_PASSWORD=

# flatfox.ch account
FLATFOX_LOGIN=
FLATFOX_PASSWORD=

# Gmail that sends emails to landlords (wohnen.ethz.ch). Use an app password:
# https://support.google.com/mail/answer/185833
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Gmail inbox that receives Flatfox's login codes (may be the same account)
CODE_INBOX_ADDRESS=
CODE_INBOX_APP_PASSWORD=
