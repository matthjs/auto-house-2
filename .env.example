# Copy this file to .env and fill in what you use. .env is git-ignored.
# Only the API key of your LLM provider is needed for a dry run; logins are
# needed for the sites you run.

# Defaults so you can leave out profile=... and llm=... (optional)
AUTO_HOUSE_PROFILE=
AUTO_HOUSE_LLM=deepseek

# LLM provider API key (only the one you use)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# wohnen.ethz.ch account
WOHNEN_ETHZ_LOGIN=
WOHNEN_ETHZ_PASSWORD=

# flatfox.ch account
FLATFOX_LOGIN=
FLATFOX_PASSWORD=

# Gmail that sends emails to landlords (wohnen.ethz.ch). Use an app password:
# https://support.google.com/mail/answer/185833
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Gmail inbox that receives Flatfox's login codes (may be the same account)
CODE_INBOX_ADDRESS=
CODE_INBOX_APP_PASSWORD=
