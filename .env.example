# Copy this file to .env and fill in what you use. .env is git-ignored.
# wgzimmer.ch, Flatfox and WOKO need nothing from this file. Email alerts and
# wohnen.ethz.ch need the contact's Gmail; batch mode (command=run) needs an LLM key.

# Defaults so you can leave out search=... and llm=... (optional).
# Without AUTO_HOUSE_LLM, the provider whose API key is set below is used.
AUTO_HOUSE_SEARCH=
AUTO_HOUSE_LLM=

# LLM API key for batch mode (command=run); only the one you use
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# The search contact's Gmail: reads the portals' alert emails (site=email_alerts)
# and sends emails to wohnen.ethz.ch landlords. Use an app password:
# https://support.google.com/mail/answer/185833
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# The search contact's wohnen.ethz.ch account
WOHNEN_ETHZ_LOGIN=
WOHNEN_ETHZ_PASSWORD=
